#include "pthreadfuncs.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>
#include <time.h>
#include <sys/syscall.h>

// common resources - is a file for logging
int g_fd = -1;
pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;

// git ID of current thread
pid_t getThreadID(void) {
    return (pid_t) syscall(SYS_gettid);
}

// write a string from thread with mutex
int write_line(const char *msg) {
if (pthread_mutex_lock(&g_lock) !=0){
return -1;
}


    ssize_t n = write(g_fd, msg, strlen(msg));

pthread_mutex_unlock(&g_lock);

    if (n < 0) {
return -1;
}
return 0;
}

// function for thread
void *func_thread(void *arg){
struct ThreadArgs *t = (struct ThreadArgs *)arg;
if (t->id == 1){
pthread_detach(pthread_self());
}
    char buf[256];

struct timespec ts;
ts.tv_sec = 0;
ts.tv_nsec = 100 * 1000 * 1000;

    // write something in opened file
    for (int i = 0; i < COUNT_ITERATIONS; ++i) {
        // here we write process id, parent process id, thread id, and name of thread with iteration
        snprintf(buf, sizeof(buf),
                 "[tag = %s] pid = %d ppid = %d tid = %d pthread_self =%lu iter = %d\n",
 t->tag,
(int)getpid(),
(int)getppid(),
(int)getThreadID(),
(unsigned long)pthread_self(),
 i);

if (write_line(buf) != 0){
fprintf(stderr,"write_line failed in thread %s\n", t->tag);
}
char msg_buf[80];
snprintf(msg_buf, sizeof(msg_buf), "%s\n", t->message);
if (write_line(msg_buf) != 0) {
fprintf(stderr, "write_line failed (message) in %s\n", t->tag);
}

nanosleep(&ts, NULL);
}
char *result = malloc(64);
if (result != NULL) {
snprintf(result, 64, "thread %d: %d: iterations",
t->id, COUNT_ITERATIONS);
}
pthread_exit(result);
}

void about(void)  {
    printf("Pthread example\n");
}
